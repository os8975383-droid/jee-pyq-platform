# Copy this file to .env and replace every placeholder.
FLASK_SECRET_KEY=replace-with-a-long-random-value
APP_ENV=development
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false

ADMIN_USERNAME=admin
# Generate a hash in the project virtual environment:
# python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-strong-password'))"
ADMIN_PASSWORD_HASH=replace-with-generated-werkzeug-password-hash

# Keep "supabase" for the online database. Set to "sqlite" for local testing.
DATABASE_BACKEND=auto
SQLITE_DATABASE_PATH=instance/jee_exam.sqlite3

SUPABASE_URL=https://your-project-id.supabase.co
# Put the Supabase service_role key here only. Never put it in templates or JavaScript.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-side-service-role-key
